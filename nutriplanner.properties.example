# Copy to nutriplanner.properties (in the folder you start the server from, or in the data folder) and edit.
# Every setting can also be given as -Dnutri.port=9090 or as an environment variable such as NUTRI_PORT=9090.

# Where to listen. 127.0.0.1 = this computer only; 0.0.0.0 = also other devices on your network.
nutri.host=127.0.0.1
nutri.port=8080

# Folder for the database file (nutriplanner.mv.db).
# nutri.data=/home/you/.nutriplanner

# Time zone for "today". Leave empty to use the computer's zone.
# nutri.zone=Asia/Kolkata

# First-run data. These only apply when the database is created.
nutri.demo=true
nutri.admin.password=Planner#Start1

# Security
nutri.session.idle.minutes=30
nutri.pbkdf2.iterations=210000

# HTTPS (optional): a PKCS#12 keystore made with keytool.
# nutri.https.keystore=/path/to/nutri.p12
# nutri.https.password=change-me
